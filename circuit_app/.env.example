# Copy to .env (never commit, never paste keys in chat). Pick ONE provider.
LLM_PROVIDER=claude            # claude | gemini
LLM_MODEL=                     # exact model id: run `python check_setup.py` to list yours
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GNANI_STT_API_KEY=             # the NEW key (revoke the one shared in chat)
GNANI_LANGUAGE_CODE=te-IN      # te-IN | hi-IN | en-IN ...
GNANI_REST_MAX_SECONDS=60
GNANI_MAX_PER_CASE=3           # our own budget, not a Gnani limit
GNANI_DEMO_MAX_STT_CALLS=8     # our own budget across all cases
AGENT_MAX_STEPS=8
