# KeepWell Configuration
APP_ENV=development
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Google Cloud & Gemini Configuration
GCP_PROJECT_ID=keepwell-pilot-mumbai
GCP_REGION=asia-south1
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_REASONING=gemini-3.8-flash

# Database Configuration (Defaults to SQLite for instant local run, Postgres for Cloud SQL)
DATABASE_URL=sqlite:///./keepwell.db
# Production Cloud SQL Postgres example:
# DATABASE_URL=postgresql://keepwell_user:password@/keepwell?host=/cloudsql/keepwell-pilot-mumbai:asia-south1:keepwell-db

# Storage
STORAGE_BACKEND=local
STORAGE_DIR=./storage
GCS_BUCKET_NAME=keepwell-media-evidence

# WhatsApp Cloud API (Optional - Simulator works locally without credentials)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=keepwell_webhook_secret_2026

# UPI Payment Gateway (Sandbox mode default)
UPI_SANDBOX_MODE=true
UPI_VPA=agency.keepwell@icici
